SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=interview_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- JWT ---
JWT_EXPIRES_MINUTES=60
# Ключ подписи токенов. Если строку не раскомментировать, используется SECRET_KEY
# JWT_SECRET=

# --- LLM (любой OpenAI-совместимый API) ---
# Ключ только на сервере, в репозиторий и во frontend не попадает
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Для разработки без ключа и без сети раскомментируйте: ответы-заглушки.
# В рабочей версии эту строку держать закомментированной
# LLM_PROVIDER=stub