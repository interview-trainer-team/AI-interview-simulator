SECRET_KEY=
# На сервере всегда False. Для локальной разработки можно поставить True
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=interview_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- JWT ---
JWT_EXPIRES_MINUTES=60
# Ключ подписи токенов. Если строку не раскомментировать, используется SECRET_KEY
# JWT_SECRET=

# --- LLM (любой OpenAI-совместимый API) ---
# Ключ только на сервере, в репозиторий и во frontend не попадает
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Для разработки без ключа и без сети раскомментируйте: ответы-заглушки.
# В рабочей версии эту строку держать закомментированной
# LLM_PROVIDER=stub

# --- Сайт ---
# Адреса frontend, которым разрешены запросы к API (CORS). Локально: Vite на 127.0.0.1:5173.
# При обычной схеме «сайт и /api на одном домене» CORS не нужен
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Адрес сайта по HTTPS для входа в админку, на сервере: https://ваш-домен
# CSRF_TRUSTED_ORIGINS=https://example.com

# --- Только для docker compose (см. docs/deployment.md) ---
# Домен сайта: Caddy сам получит HTTPS-сертификат. Пока домена нет, оставьте :80 (только HTTP)
# SITE_ADDRESS=example.com
# На сервере: DB_HOST задаётся в docker-compose.yml (db), DB_PASSWORD обязателен
