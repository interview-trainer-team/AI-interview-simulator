    "fields": {
      "direction": "backend_python",
      "level": "junior",
      "text": "\u0427\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u043c\u043e\u0434\u0443\u043b\u044c \u0438 \u043f\u0430\u043a\u0435\u0442 \u0432 Python? \u041a\u0430\u043a \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u043a\u043e\u0434 \u0438\u0437 \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u0444\u0430\u0439\u043b\u0430 \u0438\u043b\u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0439 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0438?",
      "reference_answer": "\u041c\u043e\u0434\u0443\u043b\u044c \u2014 \u044d\u0442\u043e \u0444\u0430\u0439\u043b .py \u0441 \u043a\u043e\u0434\u043e\u043c, \u043f\u0430\u043a\u0435\u0442 \u2014 \u043f\u0430\u043f\u043a\u0430 \u0441 \u043c\u043e\u0434\u0443\u043b\u044f\u043c\u0438 (\u043e\u0431\u044b\u0447\u043d\u043e \u0441 \u0444\u0430\u0439\u043b\u043e\u043c __init__.py). \u041a\u043e\u0434 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0430\u044e\u0442 \u0447\u0435\u0440\u0435\u0437 import module \u0438\u043b\u0438 from module import name, \u0430 \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0438\u0435 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0438 \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0442 \u043a\u043e\u043c\u0430\u043d\u0434\u043e\u0439 pip install.",
      "source": "BANK",
      "is_active": true
    }
  },
  {
    "model": "interviews.question",
    "pk": "8455294e-c35a-5b7b-9d43-302c946594b1",
    "fields": {
      "direction": "backend_python",
      "level": "middle",
      "text": "\u0427\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0434\u0435\u043a\u043e\u0440\u0430\u0442\u043e\u0440? \u041a\u0430\u043a \u043e\u043d \u0443\u0441\u0442\u0440\u043e\u0435\u043d \u0438 \u0432 \u043a\u0430\u043a\u0438\u0445 \u0437\u0430\u0434\u0430\u0447\u0430\u0445 \u0435\u0433\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442?",
      "reference_answer": "\u0414\u0435\u043a\u043e\u0440\u0430\u0442\u043e\u0440 \u2014 \u0444\u0443\u043d\u043a\u0446\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0444\u0443\u043d\u043a\u0446\u0438\u044e \u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043d\u043e\u0432\u0443\u044e, \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u044f \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0431\u0435\u0437 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0438\u0441\u0445\u043e\u0434\u043d\u043e\u0439 (\u043b\u043e\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435, \u043a\u0435\u0448\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435, \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u043f\u0440\u0430\u0432). \u0417\u0430\u043f\u0438\u0441\u044c @decorator \u0440\u0430\u0432\u043d\u0430 f = decorator(f). \u0427\u0442\u043e\u0431\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0438\u043c\u044f \u0438 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044e \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 functools.wraps.",
      "source": "BANK",
      "is_active": true
    }
  },
  {
    "model": "interviews.question",
    "pk": "b817d946-586a-594c-9933-3a99fc48e3ae",
    "fields": {
      "direction": "backend_python",
      "level": "middle",
      "text": "\u0412 \u0447\u0451\u043c \u0440\u0430\u0437\u043d\u0438\u0446\u0430 \u043c\u0435\u0436\u0434\u0443 \u0438\u0442\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u043c \u0438 \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u043c? \u0417\u0430\u0447\u0435\u043c \u043d\u0443\u0436\u043d\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u043e\u0435 \u0441\u043b\u043e\u0432\u043e yield?",
      "reference_answer": "\u0418\u0442\u0435\u0440\u0430\u0442\u043e\u0440 \u2014 \u043e\u0431\u044a\u0435\u043a\u0442 \u0441 \u043c\u0435\u0442\u043e\u0434\u0430\u043c\u0438 __iter__ \u0438 __next__. \u0413\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440 \u2014 \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u0441 yield (\u0438\u043b\u0438 \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0435 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u0435), \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043e\u0437\u0434\u0430\u0451\u0442 \u0438\u0442\u0435\u0440\u0430\u0442\u043e\u0440 \u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0435\u0442 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043b\u0435\u043d\u0438\u0432\u043e, \u043f\u043e \u043e\u0434\u043d\u043e\u043c\u0443, \u044d\u043a\u043e\u043d\u043e\u043c\u044f \u043f\u0430\u043c\u044f\u0442\u044c.",
      "source": "BANK",
      "is_active": true
    }
